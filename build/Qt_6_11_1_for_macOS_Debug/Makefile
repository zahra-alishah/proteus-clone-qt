proteus.app/Contents/PkgInfo: 
	@test -d proteus.app/Contents || mkdir -p proteus.app/Contents
	@$(DEL_FILE) proteus.app/Contents/PkgInfo
	@echo "APPL????" > proteus.app/Contents/PkgInfo
proteus.app/Contents/Info.plist: 
	@test -d proteus.app/Contents || mkdir -p proteus.app/Contents
	@$(DEL_FILE) proteus.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - /Users/alishah/Qt/6.11.1/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.proteus,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.proteus,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,proteus,g" -e "s,@LIBRARY@,proteus,g" -e "s,\$${EXECUTABLE_NAME},proteus,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >proteus.app/Contents/Info.plist

all: Makefile \
		proteus.app/Contents/PkgInfo \
		proteus.app/Contents/Info.plist proteus.app/Contents/MacOS/proteus

dist: distdir FORCE
