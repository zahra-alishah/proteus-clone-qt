install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/proteus/bin || mkdir -p $(INSTALL_ROOT)/opt/proteus/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/proteus/bin/proteus.app
	
	$(QINSTALL) proteus.app $(INSTALL_ROOT)/opt/proteus/bin/proteus.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/proteus/bin/proteus.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/proteus/bin/ 


